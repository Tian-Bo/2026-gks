APP_NAME="KL AI Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:4311

# Keep local API responses identical to the original merchant AI service.
AI_UPSTREAM_API_BASE_URL=http://klapis.liebiankuai.com
AI_UPSTREAM_TIMEOUT=310

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Use the same database values as ../apis/.env. Do not commit real credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Development fallback when the original MySQL service is unavailable.
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/backend/database/ai.sqlite

# Standalone mode uses these values until merchant authentication is connected.
AI_MERCHANT_ID=1
AI_SHOP_ID=1
AI_STREAM_DELAY_MS=80
# Only used by the standalone local login flow. Replace this with a real SMS
# provider before production deployment.
AI_DEMO_SMS_CODE=123456

# Localhost ports are accepted by config/cors.php. Add production origins here when deploying.
CORS_ALLOWED_ORIGINS=
